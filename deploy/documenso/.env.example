# Copy to .env on the signing host. Use independent random secrets.
# Hex-encoded database passwords avoid URL-encoding mistakes in compose.yml.
POSTGRES_PASSWORD=
NEXTAUTH_SECRET=
NEXT_PRIVATE_ENCRYPTION_KEY=
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=
NEXT_PUBLIC_WEBAPP_URL=https://sign.example.org
NEXT_PUBLIC_DISABLE_SIGNUP=false
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_SECURE=false
NEXT_PRIVATE_SMTP_USERNAME=
NEXT_PRIVATE_SMTP_PASSWORD=
NEXT_PRIVATE_SMTP_FROM_NAME=El Elyon
NEXT_PRIVATE_SMTP_FROM_ADDRESS=
NEXT_PRIVATE_SIGNING_PASSPHRASE=
