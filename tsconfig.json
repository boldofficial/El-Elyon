{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"baseUrl": ".",
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*", "./lib/*"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./lib/*"],
      "@/styles/*": ["./src/styles/*"],
			"@/public/*": ["./public/*"],
			"@/layouts/*": ["./src/layouts/*"],
			"@/pages/*": ["./src/pages/*"],
			"@/utils/*": ["./src/utils/*"],
			"@/hooks/*": ["./src/hooks/*"],
			"@/types/*": ["./src/types/*"],
			"@/contexts/*": ["./src/contexts/*"],
			"@/services/*": ["./src/services/*"],
			"@/config/*": ["./src/config/*"],
      "@/db/*": ["./db/*"]
      }
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts"
	],
	"exclude": ["node_modules"]
}
