# El Elyon -- environment variable template.
#
# Copy to `.env.local` and fill in real values. NEVER commit a filled-in copy:
# `.gitignore` excludes every `.env*` file except this template.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Primary application database. The runtime client is drizzle-orm/neon-http, so
# this must be a Neon (HTTP-protocol) connection string in deployed environments.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ---------------------------------------------------------------------------
# Isolated test databases (developer/CI only -- never a production database)
# ---------------------------------------------------------------------------
# Each integration suite creates and drops a randomly-named schema inside the
# target database, and refuses to run when the value equals DATABASE_URL. Leave
# unset and the suite SKIPS rather than fails -- so treat an unset value as
# "these proofs did not run", not as a pass.
#
# A local container is the intended target:
#   docker run -d --name el-elyon-test-pg -e POSTGRES_PASSWORD=postgres \
#     -p 55432:5432 postgres:16-alpine
#
# `npm run test:life-safety:db`
LIFE_SAFETY_TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:55432/postgres"
# `npm run test:water-temperature:db` -- the water-temperature migration,
# constraint, active-uniqueness, FK, revision-retention and concurrency proofs.
WATER_TEMPERATURE_TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:55432/postgres"

# Optional override for the rollout scripts
# (`npm run water-temperature:cutover-report` / `:post-deploy-check`).
# They fall back to DATABASE_URL when this is unset; point it at a staging
# restore to rehearse a cutover without touching production.
# WATER_TEMPERATURE_ROLLOUT_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Authentication (Clerk)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."
CLERK_JWT_ISSUER_DOMAIN="https://your-app.clerk.accounts.dev"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"

# One-time-password inspector sessions. Rotating this immediately invalidates
# every live inspector grant -- part of the water-temperature rollback path.
INSPECTOR_SESSION_SECRET="generate-a-long-random-string"

# One-time admin bootstrap.
ADMIN_BOOTSTRAP_SECRET="generate-a-long-random-string"

# ---------------------------------------------------------------------------
# Object storage (S3-compatible)
# ---------------------------------------------------------------------------
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
AWS_ENDPOINT_URL=""

# ---------------------------------------------------------------------------
# Rate limiting (Upstash Redis)
# ---------------------------------------------------------------------------
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
FROM_EMAIL="noreply@example.com"

# ---------------------------------------------------------------------------
# Internal / scheduled endpoints
# ---------------------------------------------------------------------------
CRON_SECRET="generate-a-long-random-string"
INTERNAL_API_KEY="generate-a-long-random-string"

# ---------------------------------------------------------------------------
# Application URLs
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
SITE_URL="http://localhost:3001"

# ---------------------------------------------------------------------------
# Error monitoring (Sentry)
#
# This is the ONLY operational error stream for the water-temperature feature.
# Do not add a second feature-specific telemetry or audit event stream: the
# append-only facts and reasoned revisions in the database are the canonical
# audit trail, and readings/narratives must never reach Sentry or console output.
# ---------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
